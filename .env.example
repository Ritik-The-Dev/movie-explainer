# Copy to .env and fill in. Never commit the real .env.

# Story/script generation (stages 2 and 6). Get one from your Pollinations account.
POLLINATIONS_API_KEY=
# Model routed through Pollinations' OpenAI-compatible endpoint.
POLLINATIONS_MODEL=openai
POLLINATIONS_URL=https://gen.pollinations.ai/v1/chat/completions

# Hindi narration speed used to size the script (chars per minute).
SCRIPT_CHARS_PER_MIN=850

# Optional: Telegram ping when a film finishes (needs sendTelegramNotification.py
# next to pipeline.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: local TTS backends (voiceover.py falls back through these).
# VOICEBOX_URL=http://127.0.0.1:8000
# CARTESIA_API_KEY=
